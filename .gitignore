# Ignore everything by default. The repository is maintained through an explicit whitelist.
*

# Keep Git metadata and this policy file.
!.gitignore

# Project meta and docs
!/README.md
!/CONTRIBUTING.md
!/docs/
!/docs/**

# Build/start entrypoints
!/build_serverflow.bat
!/start.bat
!/start_classic.bat
!/start_dz.bat
!/steam_appid.txt

# ServerFlow plugin scope (approved PR area)
!/csgo/
!/csgo/addons/
!/csgo/addons/sourcemod/
!/csgo/addons/sourcemod/configs/
!/csgo/addons/sourcemod/configs/serverflow/
!/csgo/addons/sourcemod/configs/serverflow/**
!/csgo/addons/sourcemod/plugins/
!/csgo/addons/sourcemod/scripting/
!/csgo/addons/sourcemod/scripting/serverflow.sp
!/csgo/addons/sourcemod/scripting/serverflow/
!/csgo/addons/sourcemod/scripting/serverflow/**

# 4. Разрешаем конкретные типы файлов внутри этих папок
!*.ini
!*.vdf
!*.sp

# Required text artifacts only
!/csgo/addons/sourcemod/plugins/serverflow.smx.b64.txt
!/csgo/addons/sourcemod/scripting/compiled/
!/csgo/addons/sourcemod/scripting/compiled/serverflow.smx.b64.txt
!/Log/
!/Log/**

# Explicitly keep out noisy legacy trees from active PR scope
/csgo/addons/sourcemod/scripting/base*/
/csgo/addons/sourcemod/scripting/fun*/
/csgo/addons/sourcemod/scripting/include/
/csgo/addons/sourcemod/scripting/testsuite/

# Never commit binary build artifacts or local secrets
/csgo/addons/sourcemod/plugins/*.smx
/csgo/addons/sourcemod/scripting/compiled/*.smx
/csgo/addons/sourcemod/scripting/spcomp.exe
/csgo/addons/sourcemod/scripting/spcomp64.exe
/csgo/addons/sourcemod/scripting/compile.exe
/csgo/addons/sourcemod/scripting/compile.dat
/csgo/cfg/server.private.cfg
/start.local.bat
*.local.bat
start_dz.local.bat
start_classic.local.bat

# Documentation
!/docs/
!/docs/*.md

# Allow committed diagnostic logs from repo-level Log folder
!/Log/
!/Log/**

# ServerFlow modular includes
!/csgo/addons/sourcemod/scripting/serverflow/
!/csgo/addons/sourcemod/scripting/serverflow/**

# Allow committed compiled ServerFlow artifact for quick server pull/run
!/csgo/addons/sourcemod/scripting/compiled/

!/csgo/addons/sourcemod/plugins/serverflow.smx.b64.txt
!/csgo/addons/sourcemod/scripting/compiled/serverflow.smx.b64.txt

# Binary artifacts are not versioned in PR flow
/csgo/addons/sourcemod/plugins/*.smx
/csgo/addons/sourcemod/scripting/compiled/*.smx
/csgo/addons/sourcemod/scripting/spcomp.exe
/csgo/addons/sourcemod/scripting/spcomp64.exe
/csgo/addons/sourcemod/scripting/compile.exe
/csgo/addons/sourcemod/scripting/compile.dat
